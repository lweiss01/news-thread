<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- More conservative scale for circular adaptive-icon masks -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:translateY="0">

        <!-- Gold "N" -->
        <path
            android:pathData="M 26,76 V 20 H 42 L 76,66 V 20 H 90 V 76 H 74 L 40,30 V 76 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="20"
                    android:endX="54"
                    android:endY="76">
                    <item android:offset="0" android:color="#F6C85C"/>
                    <item android:offset="1" android:color="#D97A17"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Spectrum pill: lifted up slightly + slightly shorter vertical footprint -->
        <path
            android:pathData="M 24,74
                              H 84
                              C 90,74 94,78 94,81
                              C 94,85 90,88 84,88
                              H 24
                              C 18,88 14,85 14,81
                              C 14,78 18,74 24,74 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="14"
                    android:startY="81"
                    android:endX="94"
                    android:endY="81">
                    <item android:offset="0" android:color="#60A5FA"/>
                    <item android:offset="0.50" android:color="#A78BFA"/>
                    <item android:offset="1" android:color="#F87171"/>
                </gradient>
            </aapt:attr>
        </path>

    </group>
</vector>