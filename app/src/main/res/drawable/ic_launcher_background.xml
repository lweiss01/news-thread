<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base deep-navy vertical gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <!-- Slightly lighter top, darker bottom (like mockup) -->
                <item android:offset="0" android:color="#17233A"/>
                <item android:offset="1" android:color="#0A1223"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft vignette overlay to add depth -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillAlpha="0.32">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="74">
                <item android:offset="0" android:color="#00000000"/>
                <item android:offset="1" android:color="#FF000000"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>